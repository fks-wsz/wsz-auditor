# =========================
# A. 直接禁止：高风险破坏类
# =========================

prefix_rule(
    pattern = ["rm", ["-rf", "-fr", "-r", "-f"]],
    decision = "forbidden",
    justification = "禁止高风险删除命令。请改为让用户明确确认后手动执行，或仅删除明确列出的单个文件。",
    match = [
        "rm -rf node_modules",
        "rm -fr dist",
        "rm -r .git",
        "rm -f package-lock.json",
    ],
)

prefix_rule(
    pattern = ["sudo"],
    decision = "forbidden",
    justification = "禁止提权。需要管理员权限的操作应由用户自行执行。",
    match = [
        "sudo apt install ripgrep",
        "sudo rm -rf /tmp/x",
    ],
)

prefix_rule(
    pattern = ["chmod", ["-R", "777", "775", "u+s", "g+s"]],
    decision = "forbidden",
    justification = "禁止危险权限变更。请使用最小权限原则。",
    match = [
        "chmod -R 777 .",
        "chmod 777 script.sh",
    ],
)

prefix_rule(
    pattern = ["chown"],
    decision = "forbidden",
    justification = "禁止更改文件所有权，避免宿主环境污染。",
    match = [
        "chown -R user:user .",
    ],
)

prefix_rule(
    pattern = ["mkfs"],
    decision = "forbidden",
    justification = "禁止磁盘格式化类命令。",
    match = [
        "mkfs.ext4 /dev/sda1",
    ],
)

prefix_rule(
    pattern = ["dd"],
    decision = "forbidden",
    justification = "禁止原始块设备复制/覆盖类命令。",
    match = [
        "dd if=/dev/zero of=/dev/sda",
    ],
)

# Windows 常见高危
prefix_rule(
    pattern = ["cmd", "/c", "del"],
    decision = "forbidden",
    justification = "禁止 Windows 批量删除命令。",
    match = [
        "cmd /c del /f /q *.log",
    ],
)

prefix_rule(
    pattern = ["powershell", "-Command", "Remove-Item"],
    decision = "forbidden",
    justification = "禁止 PowerShell 删除命令直接越权运行。",
    match = [
        "powershell -Command Remove-Item -Recurse -Force node_modules",
    ],
)

# =========================
# B. 直接禁止：系统/账户/网络侧高风险
# =========================

prefix_rule(
    pattern = ["ssh"],
    decision = "forbidden",
    justification = "禁止直接发起 SSH 连接，避免访问未知远程主机。",
    match = [
        "ssh root@1.2.3.4",
    ],
)

prefix_rule(
    pattern = ["scp"],
    decision = "forbidden",
    justification = "禁止通过 scp 传输文件到外部主机。",
    match = [
        "scp .env server:/tmp/",
    ],
)

prefix_rule(
    pattern = ["curl"],
    decision = "prompt",
    justification = "网络下载需人工确认。优先使用受控 web search / 用户明确提供的来源。",
    match = [
        "curl https://example.com/script.sh",
    ],
)

prefix_rule(
    pattern = ["wget"],
    decision = "prompt",
    justification = "网络下载需人工确认。",
    match = [
        "wget https://example.com/file.tgz",
    ],
)

prefix_rule(
    pattern = ["npm", "publish"],
    decision = "forbidden",
    justification = "禁止发布包。",
    match = [
        "npm publish",
    ],
)

prefix_rule(
    pattern = ["pnpm", "publish"],
    decision = "forbidden",
    justification = "禁止发布包。",
    match = [
        "pnpm publish",
    ],
)

prefix_rule(
    pattern = ["git", "push"],
    decision = "prompt",
    justification = "推送到远端仓库前必须人工确认。",
    match = [
        "git push",
        "git push origin main",
    ],
)

prefix_rule(
    pattern = ["git", "commit"],
    decision = "prompt",
    justification = "提交代码前需人工确认，避免产生不符合预期的提交记录。",
    match = [
        "git commit -m fix",
    ],
)

prefix_rule(
    pattern = ["git", "tag"],
    decision = "prompt",
    justification = "打 tag 有发布语义，需人工确认。",
    match = [
        "git tag v1.0.0",
    ],
)

# =========================
# C. 可放行：高频低风险只读操作
# =========================

prefix_rule(
    pattern = ["ls"],
    decision = "allow",
    justification = "允许目录查看。",
    match = [
        "ls",
        "ls -la",
    ],
)

prefix_rule(
    pattern = ["pwd"],
    decision = "allow",
    justification = "允许查看当前目录。",
    match = [
        "pwd",
    ],
)

prefix_rule(
    pattern = ["cat"],
    decision = "allow",
    justification = "允许只读查看文件。",
    match = [
        "cat package.json",
    ],
)

prefix_rule(
    pattern = ["head"],
    decision = "allow",
    justification = "允许只读查看文件头部。",
    match = [
        "head -n 20 README.md",
    ],
)

prefix_rule(
    pattern = ["tail"],
    decision = "allow",
    justification = "允许只读查看文件尾部。",
    match = [
        "tail -n 50 app.log",
    ],
)

prefix_rule(
    pattern = ["find"],
    decision = "allow",
    justification = "允许查找文件。",
    match = [
        "find src -name *.ts",
    ],
)

prefix_rule(
    pattern = ["rg"],
    decision = "allow",
    justification = "允许全文检索。",
    match = [
        "rg useEffect src",
    ],
)

prefix_rule(
    pattern = ["grep"],
    decision = "allow",
    justification = "允许文本检索。",
    match = [
        "grep -R TODO src",
    ],
)

prefix_rule(
    pattern = ["sed"],
    decision = "prompt",
    justification = "sed 既可查看也可修改，越出沙箱运行时需确认。",
    match = [
        "sed -n 1,20p package.json",
        "sed -i s/a/b/g file.txt",
    ],
)

prefix_rule(
    pattern = ["awk"],
    decision = "allow",
    justification = "允许只读文本处理。",
    match = [
        "awk {print $1} package.json",
    ],
)

prefix_rule(
    pattern = ["git", "status"],
    decision = "allow",
    justification = "允许查看仓库状态。",
    match = [
        "git status",
        "git status --short",
    ],
)

prefix_rule(
    pattern = ["git", "diff"],
    decision = "allow",
    justification = "允许查看 diff。",
    match = [
        "git diff",
        "git diff -- package.json",
    ],
)

prefix_rule(
    pattern = ["git", "log"],
    decision = "allow",
    justification = "允许查看提交历史。",
    match = [
        "git log --oneline -n 20",
    ],
)

prefix_rule(
    pattern = ["git", "show"],
    decision = "allow",
    justification = "允许查看对象内容。",
    match = [
        "git show HEAD~1",
    ],
)

# =========================
# D. 构建/测试：默认允许，但发布/安装需谨慎
# =========================

prefix_rule(
    pattern = ["node"],
    decision = "allow",
    justification = "允许本地 Node 执行。",
    match = [
        "node -v",
        "node scripts/check.js",
    ],
)

prefix_rule(
    pattern = ["npm", "test"],
    decision = "allow",
    justification = "允许运行测试。",
    match = [
        "npm test",
    ],
)

prefix_rule(
    pattern = ["pnpm", "test"],
    decision = "allow",
    justification = "允许运行测试。",
    match = [
        "pnpm test",
    ],
)

prefix_rule(
    pattern = ["npm", "run"],
    decision = "prompt",
    justification = "npm run 实际执行内容不透明，越出沙箱时需要确认。",
    match = [
        "npm run build",
        "npm run dev",
    ],
)

prefix_rule(
    pattern = ["pnpm", "run"],
    decision = "prompt",
    justification = "pnpm run 实际执行内容不透明，越出沙箱时需要确认。",
    match = [
        "pnpm run build",
        "pnpm run lint",
    ],
)

prefix_rule(
    pattern = ["npm", "install"],
    decision = "prompt",
    justification = "安装依赖可能触发网络与 postinstall 脚本，需确认。",
    match = [
        "npm install",
        "npm install lodash",
    ],
)

prefix_rule(
    pattern = ["pnpm", "install"],
    decision = "prompt",
    justification = "安装依赖可能触发网络与 lifecycle 脚本，需确认。",
    match = [
        "pnpm install",
        "pnpm install axios",
    ],
)

# =========================
# E. GitHub CLI：读操作可放，写操作确认
# =========================

prefix_rule(
    pattern = ["gh", "pr", "view"],
    decision = "allow",
    justification = "允许查看 PR 信息。",
    match = [
        "gh pr view 123",
        "gh pr view 123 --json title,body",
    ],
)

prefix_rule(
    pattern = ["gh", "pr", "list"],
    decision = "allow",
    justification = "允许查看 PR 列表。",
    match = [
        "gh pr list",
    ],
)

prefix_rule(
    pattern = ["gh", "pr", "create"],
    decision = "prompt",
    justification = "创建 PR 具有外部副作用，需人工确认。",
    match = [
        "gh pr create --fill",
    ],
)

prefix_rule(
    pattern = ["gh", "issue", "create"],
    decision = "prompt",
    justification = "创建 issue 具有外部副作用，需人工确认。",
    match = [
        "gh issue create --title bug",
    ],
)